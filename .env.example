PORT=8000
LLM_MODE=live
# AMD Token Factory gateway — obtain bearer key from developer.amd.com.cn portal
VLLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
MODEL_NAME=DeepSeek-V4-Flash
VLLM_MODEL=DeepSeek-V4-Flash
# OPENAI_API_KEY: set this to your AMD Token Factory bearer key in .env (gitignored), NEVER commit a real key
OPENAI_API_KEY=your-amd-token-factory-bearer-key-here
VLLM_TIMEOUT=35.0
RATE_LIMIT_PER_MIN=20
AUDIT_LOG_PATH=data/audit_log.json
POLICY_CONFIG_PATH=config/policy.yaml
MARGIN_CONFIG_PATH=config/margin.yaml
